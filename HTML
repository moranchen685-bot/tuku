            '健康': '健康最重要！记得多运动、多喝水 💪',
            '梦想': '有梦想就去追！加油！🌟',
            '未来': '未来可期！相信自己 ✨',
            '过去': '过去的就让它过去吧，向前看！',
            '现在': '活在当下，享受每一刻！',
            '朋友': '朋友是人生的财富！珍惜身边的每一个人',
            '家人': '家人永远是最坚实的后盾 💕',
            '爱情': '爱情很美好，但也要好好爱自己哦',
            '旅行': '世界那么大，我想去看看！✈️',
            '美食': '说到美食我就饿了！推荐几家好吃的店？🍜',
            '运动': '运动使人快乐！一起动起来吧 🏃',
            '读书': '书中自有黄金屋！最近在读什么书？📖',
            '编程': '编程改变世界！你是做什么方向的？💻',
            '代码': '代码写得好，bug 少烦恼！',
            'bug': 'bug 是程序员的日常，修完就成长了！',
            '微信': '这是一个微信模拟器，体验还不错吧？',
            '模拟器': '是的！这是一个模拟微信聊天的网页应用',
            'AI': '我是智能AI助手，会根据你的消息自动回复！',
            '智能': '我会尽力理解你的意思并给出合适的回复',
            '机器人': '我是AI机器人，但我会用心和你交流的！🤖'
        };

        const defaultResponses = [
            '有意思！继续说',
            '我明白了',
            '真的吗？',
            '听起来不错！',
            '嗯嗯',
            '这样啊',
            '了解了',
            '哈哈',
            '确实',
            '你说得对'
        ];

        // 初始化头像选择器
        function initAvatarPicker() {
            const grid = document.getElementById('avatarGrid');
            grid.innerHTML = '';
            avatars.forEach(avatar => {
                const div = document.createElement('div');
                div.className = 'avatar-option';
                div.textContent = avatar;
                div.onclick = () => selectAvatar(avatar);
                grid.appendChild(div);
            });
        }

        // 打开头像选择器
        function openAvatarPicker(target) {
            avatarPickerTarget = target;
            document.getElementById('avatarPicker').classList.add('show');
        }

        // 关闭头像选择器
        function closeAvatarPicker() {
            document.getElementById('avatarPicker').classList.remove('show');
            avatarPickerTarget = null;
        }

        // 选择头像
        function selectAvatar(avatar) {
            if (avatarPickerTarget === 'user') {
                userAvatar = avatar;
                document.getElementById('userAvatar').textContent = avatar;
            } else if (avatarPickerTarget === 'current' && currentContact) {
                contacts[currentContact].avatar = avatar;
                updateContactAvatar(currentContact, avatar);
                document.getElementById('chatHeaderAvatar').textContent = avatar;
                document.getElementById('typingAvatar').textContent = avatar;
                refreshMessages();
            }
            closeAvatarPicker();
        }

        // 更新联系人头像
        function updateContactAvatar(name, avatar) {
            const contactItems = document.querySelectorAll('.contact-item');
            contactItems.forEach(item => {
                if (item.dataset.name === name) {
                    item.querySelector('.contact-avatar').textContent = avatar;
                }
            });
        }

        // 选择联系人
        function selectContact(name) {
            currentContact = name;

            // 更新选中状态
            document.querySelectorAll('.contact-item').forEach(item => {
                item.classList.remove('active');
                if (item.dataset.name === name) {
                    item.classList.add('active');
                }
            });

            // 更新聊天窗口
            document.getElementById('chatTitle').textContent = name;
            document.getElementById('chatHeaderAvatar').textContent = contacts[name].avatar;
            document.getElementById('chatHeaderAvatar').style.display = 'flex';
            document.getElementById('welcomeMessage').style.display = 'none';
            document.getElementById('chatInputArea').style.display = 'flex';
            document.getElementById('typingAvatar').textContent = contacts[name].avatar;

            refreshMessages();
            document.getElementById('messageInput').focus();
        }

        // 刷新消息列表
        function refreshMessages() {
            const chatMessages = document.getElementById('chatMessages');
            const typingIndicator = document.getElementById('typingIndicator');

            // 清除旧消息（保留欢迎消息和打字指示器）
            const oldMessages = chatMessages.querySelectorAll('.message');
            oldMessages.forEach(msg => msg.remove());

            if (currentContact && contacts[currentContact]) {
                contacts[currentContact].messages.forEach(msg => {
                    const messageDiv = createMessageElement(msg.text, msg.isSelf, msg.avatar);
                    chatMessages.insertBefore(messageDiv, typingIndicator);
                });
            }

            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        // 创建消息元素
        function createMessageElement(text, isSelf, avatar) {
            const div = document.createElement('div');
            div.className = `message ${isSelf ? 'self' : 'other'}`;
            div.innerHTML = `
                <div class="message-avatar">${avatar}</div>
                <div class="message-content">${escapeHtml(text)}</div>
            `;
            return div;
        }

        // 发送消息
        function sendMessage() {
            const input = document.getElementById('messageInput');
            const text = input.value.trim();

            if (!text || !currentContact) return;

            // 添加用户消息
            contacts[currentContact].messages.push({
                text: text,
                isSelf: true,
                avatar: userAvatar
            });

            input.value = '';
            refreshMessages();
            updatePreview(currentContact, text);

            // 显示AI正在输入
            showTypingIndicator();

            // AI回复
            setTimeout(() => {
                hideTypingIndicator();
                const response = generateAIResponse(text);
                contacts[currentContact].messages.push({
                    text: response,
                    isSelf: false,
                    avatar: contacts[currentContact].avatar
                });
                refreshMessages();
                updatePreview(currentContact, response);
            }, 1500 + Math.random() * 1000);
        }

        // 显示打字指示器
        function showTypingIndicator() {
            document.getElementById('typingIndicator').classList.add('show');
            const chatMessages = document.getElementById('chatMessages');
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        // 隐藏打字指示器
        function hideTypingIndicator() {
            document.getElementById('typingIndicator').classList.remove('show');
        }

        // 生成AI回复
        function generateAIResponse(text) {
            const lowerText = text.toLowerCase();

            for (const [keyword, response] of Object.entries(aiResponses)) {
                if (lowerText.includes(keyword)) {
                    return response;
                }
            }

            // 随机默认回复
            return defaultResponses[Math.floor(Math.random() * defaultResponses.length)];
        }

        // 更新预览
        function updatePreview(name, text) {
            const preview = document.getElementById(`preview-${name}`);
            if (preview) {
                preview.textContent = text.length > 15 ? text.substring(0, 15) + '...' : text;
            }
        }

        // 处理键盘事件
        function handleKeyPress(event) {
            if (event.key === 'Enter') {
                sendMessage();
            }
        }

        // 搜索联系人
        function searchContacts() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const contactItems = document.querySelectorAll('.contact-item');

            contactItems.forEach(item => {
                const name = item.dataset.name.toLowerCase();
                if (name.includes(searchTerm)) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        // 打开添加联系人弹窗
        function openAddContactModal() {
            document.getElementById('addContactModal').classList.add('show');
            document.getElementById('newContactName').value = '';
            document.getElementById('newContactName').focus();
        }

        // 关闭添加联系人弹窗
        function closeAddContactModal() {
            document.getElementById('addContactModal').classList.remove('show');
        }

        // 添加联系人
        function addContact() {
            const name = document.getElementById('newContactName').value.trim();

            if (!name) {
                alert('请输入联系人名称');
                return;
            }

            if (contacts[name]) {
                alert('该联系人已存在');
                return;
            }

            // 随机分配头像
            const randomAvatar = avatars[Math.floor(Math.random() * avatars.length)];
            contacts[name] = { avatar: randomAvatar, messages: [] };

            // 添加到列表
            const contactList = document.getElementById('contactList');
            const contactItem = document.createElement('div');
            contactItem.className = 'contact-item';
            contactItem.dataset.name = name;
            contactItem.onclick = () => selectContact(name);
            contactItem.innerHTML = `
                <div class="contact-avatar">${randomAvatar}</div>
                <div class="contact-info">
                    <div class="contact-name">${name}</div>
                    <div class="contact-preview" id="preview-${name}">点击开始聊天</div>
                </div>
            `;
            contactList.appendChild(contactItem);

            closeAddContactModal();
            selectContact(name);
        }

        // HTML转义
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // 点击弹窗外部关闭
        document.getElementById('addContactModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeAddContactModal();
            }
        });

        // 初始化
        initAvatarPicker();
    </script>
</body>
</html>