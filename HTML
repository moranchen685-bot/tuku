<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>微信模拟器</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .wechat-container {
            width: 900px;
            height: 600px;
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            display: flex;
            overflow: hidden;
        }

        /* 左侧信息栏 */
        .sidebar {
            width: 280px;
            background: #2e2e2e;
            display: flex;
            flex-direction: column;
            color: #fff;
        }

        .user-info {
            padding: 20px;
            text-align: center;
            border-bottom: 1px solid #3a3a3a;
        }

        .user-avatar {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: #07c160;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            margin: 0 auto 10px;
            cursor: pointer;
            transition: transform 0.2s;
            user-select: none;
        }

        .user-avatar:hover {
            transform: scale(1.1);
        }

        .user-name {
            font-size: 16px;
            font-weight: 500;
            margin-bottom: 4px;
        }

        .user-id {
            font-size: 12px;
            color: #999;
        }

        .search-box {
            padding: 10px 15px;
            border-bottom: 1px solid #3a3a3a;
        }

        .search-box input {
            width: 100%;
            padding: 8px 12px;
            border-radius: 4px;
            border: none;
            background: #3a3a3a;
            color: #fff;
            font-size: 14px;
            outline: none;
        }

        .search-box input::placeholder {
            color: #888;
        }

        .contact-list {
            flex: 1;
            overflow-y: auto;
        }

        .contact-item {
            display: flex;
            align-items: center;
            padding: 12px 15px;
            cursor: pointer;
            transition: background 0.2s;
            border-bottom: 1px solid #3a3a3a;
        }

        .contact-item:hover {
            background: #3a3a3a;
        }

        .contact-item.active {
            background: #3a3a3a;
        }

        .contact-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #07c160;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            margin-right: 12px;
            flex-shrink: 0;
        }

        .contact-info {
            flex: 1;
            min-width: 0;
        }

        .contact-name {
            font-size: 14px;
            font-weight: 500;
            margin-bottom: 2px;
        }

        .contact-preview {
            font-size: 12px;
            color: #999;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .add-contact-btn {
            padding: 12px 15px;
            text-align: center;
            cursor: pointer;
            color: #07c160;
            font-size: 14px;
            border-top: 1px solid #3a3a3a;
            transition: background 0.2s;
        }

        .add-contact-btn:hover {
            background: #3a3a3a;
        }

        /* 右侧聊天窗口 */
        .chat-window {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: #f5f5f5;
        }

        .chat-header {
            padding: 15px 20px;
            background: #fff;
            border-bottom: 1px solid #e0e0e0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .chat-header-title {
            font-size: 16px;
            font-weight: 500;
            color: #333;
        }

        .chat-header-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #07c160;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            cursor: pointer;
            transition: transform 0.2s;
        }

        .chat-header-avatar:hover {
            transform: scale(1.1);
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
        }

        .welcome-message {
            text-align: center;
            padding: 40px 20px;
            color: #999;
        }

        .welcome-message h3 {
            font-size: 18px;
            color: #666;
            margin-bottom: 10px;
        }

        .welcome-message p {
            font-size: 14px;
            line-height: 1.6;
        }

        .message {
            display: flex;
            margin-bottom: 15px;
            align-items: flex-start;
        }

        .message.self {
            flex-direction: row-reverse;
        }

        .message-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #07c160;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
            cursor: pointer;
            transition: transform 0.2s;
        }

        .message-avatar:hover {
            transform: scale(1.1);
        }

        .message-content {
            max-width: 60%;
            padding: 10px 14px;
            border-radius: 4px;
            font-size: 14px;
            line-height: 1.5;
            word-wrap: break-word;
            margin: 0 10px;
        }

        .message.self .message-content {
            background: #95ec69;
            color: #333;
        }

        .message.other .message-content {
            background: #fff;
            color: #333;
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }

        .chat-input-area {
            padding: 15px 20px;
            background: #fff;
            border-top: 1px solid #e0e0e0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .chat-input {
            flex: 1;
            padding: 10px 15px;
            border: 1px solid #e0e0e0;
            border-radius: 4px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s;
        }

        .chat-input:focus {
            border-color: #07c160;
        }

        .send-btn {
            padding: 10px 20px;
            background: #07c160;
            color: #fff;
            border: none;
            border-radius: 4px;
            font-size: 14px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .send-btn:hover {
            background: #06ad56;
        }

        .send-btn:active {
            background: #059a4c;
        }

        /* 添加联系人弹窗 */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal-overlay.show {
            display: flex;
        }

        .modal {
            background: #fff;
            border-radius: 8px;
            padding: 30px;
            width: 350px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        }

        .modal h3 {
            margin-bottom: 20px;
            font-size: 18px;
            color: #333;
        }

        .modal input {
            width: 100%;
            padding: 10px;
            border: 1px solid #e0e0e0;
            border-radius: 4px;
            font-size: 14px;
            margin-bottom: 15px;
            outline: none;
        }

        .modal input:focus {
            border-color: #07c160;
        }

        .modal-buttons {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .modal-btn {
            padding: 8px 20px;
            border: none;
            border-radius: 4px;
            font-size: 14px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .modal-btn.cancel {
            background: #f0f0f0;
            color: #666;
        }

        .modal-btn.cancel:hover {
            background: #e0e0e0;
        }

        .modal-btn.confirm {
            background: #07c160;
            color: #fff;
        }

        .modal-btn.confirm:hover {
            background: #06ad56;
        }

        /* 头像选择器 */
        .avatar-picker {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: #fff;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            z-index: 1001;
            max-width: 300px;
        }

        .avatar-picker.show {
            display: block;
        }

        .avatar-picker h4 {
            margin-bottom: 15px;
            font-size: 16px;
            color: #333;
        }

        .avatar-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 10px;
            margin-bottom: 15px;
        }

        .avatar-option {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #07c160;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            cursor: pointer;
            transition: transform 0.2s, background 0.2s;
        }

        .avatar-option:hover {
            transform: scale(1.2);
            background: #06ad56;
        }

        .avatar-picker-close {
            text-align: center;
            padding: 8px;
            cursor: pointer;
            color: #999;
            font-size: 14px;
        }

        .avatar-picker-close:hover {
            color: #666;
        }

        .typing-indicator {
            display: none;
            align-items: center;
            margin-bottom: 15px;
        }

        .typing-indicator.show {
            display: flex;
        }

        .typing-indicator .message-avatar {
            margin-right: 10px;
        }

        .typing-dots {
            display: flex;
            gap: 4px;
            padding: 10px 14px;
            background: #fff;
            border-radius: 4px;
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }

        .typing-dots span {
            width: 6px;
            height: 6px;
            background: #999;
            border-radius: 50%;
            animation: typing 1.4s infinite;
        }

        .typing-dots span:nth-child(2) {
            animation-delay: 0.2s;
        }

        .typing-dots span:nth-child(3) {
            animation-delay: 0.4s;
        }

        @keyframes typing {
            0%, 60%, 100% { transform: translateY(0); }
            30% { transform: translateY(-5px); }
        }

        /* 滚动条样式 */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 3px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #666;
        }
    </style>
</head>
<body>
    <div class="wechat-container">
        <!-- 左侧信息栏 -->
        <div class="sidebar">
            <div class="user-info">
                <div class="user-avatar" id="userAvatar" onclick="openAvatarPicker('user')">😊</div>
                <div class="user-name">我的微信</div>
                <div class="user-id">微信号: me123</div>
            </div>

            <div class="search-box">
                <input type="text" id="searchInput" placeholder="搜索联系人..." oninput="searchContacts()">
            </div>

            <div class="contact-list" id="contactList">
                <div class="contact-item" data-name="小明" onclick="selectContact('小明')">
                    <div class="contact-avatar">👦</div>
                    <div class="contact-info">
                        <div class="contact-name">小明</div>
                        <div class="contact-preview" id="preview-小明">点击开始聊天</div>
                    </div>
                </div>
                <div class="contact-item" data-name="小红" onclick="selectContact('小红')">
                    <div class="contact-avatar">👧</div>
                    <div class="contact-info">
                        <div class="contact-name">小红</div>
                        <div class="contact-preview" id="preview-小红">点击开始聊天</div>
                    </div>
                </div>
            </div>

            <div class="add-contact-btn" onclick="openAddContactModal()">
                + 添加新朋友
            </div>
        </div>

        <!-- 右侧聊天窗口 -->
        <div class="chat-window">
            <div class="chat-header">
                <div class="chat-header-title" id="chatTitle">欢迎使用微信模拟器</div>
                <div class="chat-header-avatar" id="chatHeaderAvatar" onclick="openAvatarPicker('current')" style="display:none;">😊</div>
            </div>

            <div class="chat-messages" id="chatMessages">
                <div class="welcome-message" id="welcomeMessage">
                    <h3>👋 欢迎使用微信模拟器</h3>
                    <p>点击左侧联系人开始聊天<br>您可以添加新朋友，智能AI会根据关键词自动回复消息<br>点击头像可以更换表情符号</p>
                </div>

                <div class="typing-indicator" id="typingIndicator">
                    <div class="message-avatar" id="typingAvatar">👦</div>
                    <div class="typing-dots">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                </div>
            </div>

            <div class="chat-input-area" id="chatInputArea" style="display:none;">
                <input type="text" class="chat-input" id="messageInput" placeholder="输入消息..." onkeypress="handleKeyPress(event)">
                <button class="send-btn" onclick="sendMessage()">发送</button>
            </div>
        </div>
    </div>

    <!-- 添加联系人弹窗 -->
    <div class="modal-overlay" id="addContactModal">
        <div class="modal">
            <h3>添加新朋友</h3>
            <input type="text" id="newContactName" placeholder="请输入联系人名称">
            <div class="modal-buttons">
                <button class="modal-btn cancel" onclick="closeAddContactModal()">取消</button>
                <button class="modal-btn confirm" onclick="addContact()">添加</button>
            </div>
        </div>
    </div>

    <!-- 头像选择器 -->
    <div class="avatar-picker" id="avatarPicker">
        <h4>选择头像</h4>
        <div class="avatar-grid" id="avatarGrid"></div>
        <div class="avatar-picker-close" onclick="closeAvatarPicker()">关闭</div>
    </div>

    <script>
        // 数据存储
        const avatars = ['😊', '😎', '🤔', '😍', '🥳', '😂', '🤗', '😴', '🤓', '🥰', '😋', '🤪', '😇', '🤠', '🥸', '😷', '🤢', '🤡', '👻', '👽', '🤖', '💩', '👍', '👎', '👏', '👋', '✌️', '🤟', '🤘', '🤙'];

        let contacts = {
            '小明': { avatar: '👦', messages: [] },
            '小红': { avatar: '👧', messages: [] }
